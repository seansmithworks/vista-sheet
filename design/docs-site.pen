                        {
                          "type": "frame",
                          "id": "odsXU",
                          "name": "Code body",
                          "width": "fill_container",
                          "padding": 20,
                          "children": [
                            {
                              "type": "text",
                              "id": "lWfFl",
                              "name": "Source",
                              "fill": "$text",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "\"use client\";\n\nimport { Iris } from \"@[name]/iris\";\n\nexport default function ContactTrigger() {\n  return (\n    <Iris.Root>\n      <Iris.Shadow />\n\n      <Iris.Trigger aria-label=\"Open contact\">\n        <Iris.Shared>\n          <div style={{ width: \"100%\", height: \"100%\", background: \"#1d1d1f\" }} />\n        </Iris.Shared>\n      </Iris.Trigger>\n\n      <Iris.Sheet aria-labelledby=\"sheet-title\">\n        <Iris.Shared>\n          <div style={{ width: \"100%\", height: \"100%\", background: \"#1d1d1f\" }} />\n        </Iris.Shared>\n\n        <Iris.Close aria-label=\"Close\" />\n\n        <Iris.Content>\n          <Iris.Item>\n            <h2 id=\"sheet-title\">Sean Smith</h2>\n          </Iris.Item>\n          <Iris.Item>\n            <p>Links, etc.</p>\n          </Iris.Item>\n        </Iris.Content>\n      </Iris.Sheet>\n    </Iris.Root>\n  );\n}",
                              "lineHeight": 1.54,
                              "fontFamily": "$font-mono",
                              "fontSize": 13
                            }
                          ]
                        }
                      ]
